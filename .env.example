# Скопируйте файл в .env и при необходимости измените значения

APP_NAME=Subscription Manager API
DEBUG=false
LOG_LEVEL=INFO

# Подключение к БД (по умолчанию SQLite в файле рядом с проектом)
DATABASE_URL=sqlite:///./subscriptions.db

# JWT
JWT_SECRET=please-change-this-secret-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Ссылка, которая уходит пользователю в письме для сброса пароля
FRONTEND_RESET_URL=http://localhost:3000/reset-password

# Планировщик автоплатежей и уведомлений
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600
DEFAULT_NOTIFY_DAYS_BEFORE=3

# Валюта по умолчанию (используется в аналитике, если истории платежей нет)
DEFAULT_CURRENCY=RUB

# SMTP. Если SMTP_HOST не задан, письма только пишутся в лог (режим разработки)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@subscriptions.local
SMTP_STARTTLS=true

# CORS: список источников через запятую либо *
CORS_ORIGINS=*
